# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. This lists every variable the app reads.
# The public site + lead capture only need the Resend and Notion groups; the
# rest power the scheduled back-office crons (member/finance/schedule sync,
# reviews, ad spend, analytics).
# ---------------------------------------------------------------------------

# --- Resend transactional email ---
# Sends the lead confirmation, onboarding drip and consultation-reminder emails,
# all via published Resend templates. LEAD_FROM_EMAIL must be a verified
# gainstrengththerapy.com sender; LEAD_NOTIFY_EMAIL receives the internal
# "new enquiry" alert.
RESEND_API_KEY=
LEAD_FROM_EMAIL=
LEAD_NOTIFY_EMAIL=
# Verifies inbound Resend webhook signatures (/api/resend-webhook).
RESEND_WEBHOOK_SECRET=

# --- Notion ---
# Leads land in NOTION_LEADS_DB_ID. The member/onboarding and finance crons use
# the members/finances DBs; DASHBOARD_PAGE_ID and RETENTION_DIGEST_PARENT_PAGE_ID
# are the Notion pages the dashboard refresh and retention digest write into.
NOTION_TOKEN=
NOTION_LEADS_DB_ID=
NOTION_MEMBERS_DB_ID=
NOTION_FINANCES_DB_ID=
DASHBOARD_PAGE_ID=
RETENTION_DIGEST_PARENT_PAGE_ID=

# --- Cal.com (consultation booking) ---
# API key powers the consultation-reminders cron (our own "your consultation is
# tomorrow" email, gated on live booking status so cancellations are not
# reminded). CALCOM_EVENT_SLUG defaults to "consultation". The booking link
# shown on the site is hardcoded in SITE.bookingUrl (src/lib/utils.ts).
CALCOM_API_KEY=
CALCOM_EVENT_SLUG=

# --- Cron authentication ---
# Shared secret(s) authenticating Vercel cron + diagnostic requests
# (?key= or Bearer header). Either value is accepted.
CRON_SECRET=
TEAMUP_DIAG_KEY=

# --- TeamUp (membership platform sync) ---
TEAMUP_M2M_TOKEN=
TEAMUP_PROVIDER_ID=
TEAMUP_WEBHOOK_SECRET=

# --- Onboarding drip controls ---
# ONBOARDING_DRIP_START_DATE (YYYY-MM-DD) gates who enters the drip; set
# ONBOARDING_NUTRITION_GUIDE_READY=true once the nutrition guide PDF is hosted.
ONBOARDING_DRIP_START_DATE=
ONBOARDING_NUTRITION_GUIDE_READY=

# --- Google reviews cron ---
GOOGLE_PLACES_API_KEY=

# --- Meta ad spend cron ---
META_AD_ACCOUNT_ID=
META_ACCESS_TOKEN=

# --- AI email opener (optional) ---
# When set and a lead's message is 30+ chars, generates a 1-2 sentence
# personalised acknowledgement (Claude Haiku).
ANTHROPIC_API_KEY=

# --- Meta pixel (ads) ---
# OFF unless NEXT_PUBLIC_META_PIXEL_ID is set: no Meta script, no Meta cookie.
# Use Gain's EXISTING dataset id from Events Manager > Data Sources. Creating a
# new pixel instead silently discards the event history, the Website Visitors
# custom audience and every lookalike built from it.
NEXT_PUBLIC_META_PIXEL_ID=
# The facebook-domain-verification code from Events Manager > Brand safety >
# Domains. Served as a meta tag because the DNS for gainstrengththerapy.com sits
# in the business partner's 123reg account.
META_DOMAIN_VERIFICATION=
